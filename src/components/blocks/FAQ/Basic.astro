---
// Basic FAQ section
// ------------
// Description: A section that contains a list of frequently asked questions with answers.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import Accordion from '../../ui/Accordion.astro'
import Card from '../../ui/cards/partials/Card.astro'

// Props
type Props = {
	classes?: string
}
const { classes } = Astro.props
---

<Section id="FAQ" classes={classes}>
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-pretty">
				Desmitificando <strong>precios</strong>, preguntas comunes resueltas
			</h2>
			<p class="text-lg leading-relaxed">
				¿Curioso sobre nuestros planes de precios? Estamos aquí para ayudar. A continuación, algunas de las preguntas más frecuentes sobre nuestras opciones de precios.
			</p>
		</Col>
		<Col span="2" />
		<Col span="8">
			<Card classes="divide-y divide-neutral-100 dark:divide-neutral-800">
				<Accordion
					title="¿Qué es Katuq y para quién está diseñado?"
					text="Katuq es una plataforma “todo en uno” que ayuda a comercios de cualquier tamaño a gestionar su negocio, desde inventarios hasta ventas en línea."
				/>
				<Accordion
					title="¿Qué diferencia a Katuq de Shopify u otras plataformas?"
					text="Katuq es 100% colombiano, ofrece precios accesibles y herramientas personalizables adaptadas a las necesidades locales."
				/>
				<Accordion
					title="¿Qué incluye Katuq?"
					text="Módulos como gestión de productos, inventarios, dashboard de métricas, y KAI, un asistente virtual para marketing y soporte."
				/>
				<Accordion
					title="¿Cómo me ayuda KAI en mi negocio?"
					text="KAI es un chatbot inteligente que optimiza la atención al cliente, genera descripciones de productos y puede integrarse con WhatsApp."
				/>
				<Accordion
					title="¿Cuáles son los planes y precios de Katuq?"
					text="Ofrecemos planes flexibles según el tamaño de tu negocio, desde emprendedores hasta grandes empresas, con opciones personalizables."
				/>
				<Accordion
					title="¿Es segura la plataforma?"
					text="Sí, Katuq utiliza tecnología avanzada para proteger la información de tu negocio y tus clientes, cumpliendo con las normativas legales."
				/>
				<Accordion
					title="¿Puedo probar Katuq antes de contratar?"
					text="Sí, ofrecemos un período de prueba gratuita para que descubras cómo Katuq puede transformar tu negocio."
				/>
				<Accordion
					title="¿Necesito conocimientos técnicos para usar Katuq?"
					text="No, la plataforma es fácil de usar, y además ofrecemos tutoriales y soporte técnico para ayudarte en todo momento."
				/>
				<Accordion
					title="¿Se integra Katuq con otras herramientas y pasarelas de pago?"
					text="Sí, Katuq es compatible con múltiples herramientas y pasarelas de pago locales e internacionales."
				/>
				<Accordion
					title="¿Qué tipo de soporte ofrece Katuq?"
					text="Brindamos soporte técnico y asesorías personalizadas para ayudarte a optimizar tu negocio y sacarle el máximo provecho a la plataforma."
				/>
			</Card>
		</Col>
		<Col span="2" />
	</Row>
</Section>

<style>
	.page-header {
		@apply mx-auto max-w-3xl;
	}
	.page-header__text {
		@apply text-lg leading-relaxed;
	}
</style>

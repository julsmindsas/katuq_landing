---
// Page Header Section
// ------------
// Description: The basic page header.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
import { Image } from 'astro:assets'

// Props
//Imagen
import fraseLogo from '../../../assets/frase-logo.png'
type Props = {
	id?: string
	title?: string
	text?: string
	classes?: string
}
const { id = 'intro', title, text, classes } = Astro.props
---

<Section id={id} classes=`bg-neutral-50 dark:bg-neutral-900 ${classes}`>
	<Row>
		<Col span="12" align="center">
			<Image
			src={fraseLogo}
			alt="Katuq incrementa y reduce"
			class="translate-y8 shadow-2xl shadow-neutral-200 dark:shadow-neutral-950 "
			format='webp'
		/></Col>
	</Row>
</Section>

<style>
	.page-header {
		@apply mx-auto max-w-3xl;
	}
	.page-header__text {
		@apply text-lg leading-relaxed;
	}
</style>

---
// Home page CTA Section
// ------------
// Description: A centered call to action section that contains: a title, text, a user review snippet, a button and a image.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import { Image } from 'astro:assets'
import Button from '../../ui/Button.astro'

// Content
// - Hero Image
import heroImage from '../../../assets/hero-01.png'
import hero2Image from '../../../assets/hero-02.png'
---

<Section id="intro" padding="top" classes="bg-neutral-50 dark:bg-neutral-900">
	<Row>
		<Col span="2" />
		<Col span="8" align="center">
			 <h1 class="">Simplifica tus procesos,</h1> 
			 <h1 class="">Aumenta tus resultados</h1>
			<p class="pb-0 text-lg">Automatiza, optimiza y conquista tu mercado.</p>
			<Button size="xl" link="/">Conoce más</Button>
		</Col>
		<Col span="2" />
		<Col span="2" />
		<Col span="8">
			<div class="image-container">
				<Image
				src={heroImage}
				alt="Katuq rentabilidad y eficiencia"
				class="translate-y+8 shadow-2xl shadow-neutral-200 dark:shadow-neutral-950 "
			/>
			<Image
				src={hero2Image}
				alt="Katuq incrementa y reduce"
				class="translate-y8 shadow-2xl shadow-neutral-200 dark:shadow-neutral-950 "
				format='webp'
			/></Col
		>
			</div>
		<Col span="2" />
	</Row>
</Section>
<style>
	.image-container {
		display: flex ;
		gap: 5rem;
		justify-content: center;
		margin-top: 1rem;
	}
	img {
		max-width: auto;
		height: 400px;
	}
</style>

---
// Feature Cards grid Section
// ------------
// Description: A grid of cards with feature information in a 4 column layout.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import { Image } from 'astro:assets'
import Card from '../../ui/cards/FeatureCard.astro'

// Content
// - Cards
import feature01 from '../../../assets/cards/feature-01.png'
import feature02 from '../../../assets/cards/feature-02.png'
import feature03 from '../../../assets/cards/feature-03.png'
import feature04 from '../../../assets/cards/feature-04.png'
import feature05 from '../../../assets/cards/feature-05.png'
// titulo
import Recurso8ktuq from '../../../assets/Recurso8ktuq.png'
---

<Section id="features">
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<Image src={Recurso8ktuq} alt="All your data in one place" />
		</Col>
	</Row>
	<Row>
		<Col span="4">
			<Card image={feature01} link="/features" />
		</Col>
		<Col span="4" classes="flex flex-col gap-6">
			<Card image={feature02} link="/features" />
			<Card image={feature03} link="/features" />
		</Col>
		<Col span="4" classes="flex flex-col gap-6">
			<Card image={feature04} link="/features" />
			<Card image={feature05} link="/features" />
		</Col>
	</Row>
</Section>

<style>
	.feature-image {
		width: 100%;
		height: auto;
		object-fit: cover;
	}
	.feature-card {
		width: 100%;
		height: 100%;
	}
</style>

---
// Simple Demo Booking Component
// ------------
// Description: Simple component for booking demo appointments using Google Calendar button
// Properties:
// - appointmentUrl: Your Google Calendar appointment scheduling URL
// - buttonColor: Color for the booking button
// - buttonText: Text for the booking button
// - classes: Additional classes
// ------------

// Components
import Card from '../../ui/cards/partials/Card.astro'
import CardBody from '../../ui/cards/partials/CardBody.astro'

// Config
import { appointmentConfig } from '../../../config/config'

// Props
type Props = {
	appointmentUrl?: string
	buttonColor?: string
	buttonText?: string
	classes?: string
}

const { 
	appointmentUrl = appointmentConfig.demoBookingUrl,
	buttonColor = appointmentConfig.buttonColor,
	buttonText = appointmentConfig.buttonText,
	classes 
} = Astro.props
---

<Card classes={classes}>
	<CardBody>
		<div class="text-center space-y-6">
			<div class="space-y-4">
				<div class="inline-flex items-center justify-center w-16 h-16 bg-primary-100 dark:bg-primary-900 rounded-full mb-4">
					<svg class="w-8 h-8 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
					</svg>
				</div>
				
				<h2 class="text-3xl font-bold text-neutral-900 dark:text-white">
					Agenda tu Demo de Katuq
				</h2>
				
				<p class="text-lg text-neutral-600 dark:text-neutral-300 max-w-2xl mx-auto">
					Descubre cómo nuestras soluciones de IA pueden transformar tu negocio. 
					Agenda una demo personalizada de 30 minutos con nuestro equipo.
				</p>
			</div>

			<!-- Primary Demo Booking Button -->
			<div class="my-8">
				<a 
					href={appointmentUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="primary-demo-button inline-flex items-center justify-center px-8 py-4 text-lg font-semibold rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-all duration-300"
				>
					<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
					</svg>
					{buttonText}
				</a>
				<p class="mt-3 text-sm text-neutral-500 dark:text-neutral-400">
					✅ Demo personalizada de 30 minutos • ✅ Sin compromiso • ✅ Análisis gratuito incluido
				</p>
			</div>

			<!-- Google Calendar Integration (hidden, as backup) -->
			<div id="google-appointment-button" class="hidden">
				<!-- Google Calendar button will load here if available -->
			</div>

			<!-- What to expect -->
			<div class="bg-neutral-50 dark:bg-neutral-800 rounded-lg p-6 space-y-4">
				<h3 class="text-xl font-semibold text-neutral-900 dark:text-white">
					¿Qué esperar en la demo?
				</h3>
				<div class="grid md:grid-cols-2 gap-4 text-left">
					<div class="flex items-start space-x-3">
						<svg class="w-5 h-5 text-green-500 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
						</svg>
						<span class="text-neutral-700 dark:text-neutral-300">Análisis de tus necesidades específicas</span>
					</div>
					<div class="flex items-start space-x-3">
						<svg class="w-5 h-5 text-green-500 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
						</svg>
						<span class="text-neutral-700 dark:text-neutral-300">Demo en vivo de nuestras funcionalidades</span>
					</div>
					<div class="flex items-start space-x-3">
						<svg class="w-5 h-5 text-green-500 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
						</svg>
						<span class="text-neutral-700 dark:text-neutral-300">Propuesta personalizada de implementación</span>
					</div>
					<div class="flex items-start space-x-3">
						<svg class="w-5 h-5 text-green-500 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
							<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
						</svg>
						<span class="text-neutral-700 dark:text-neutral-300">Sesión de preguntas y respuestas</span>
					</div>
				</div>
			</div>
		</div>
	</CardBody>
</Card>

<!-- Google Calendar Appointment Scheduling Script -->
<link href="https://calendar.google.com/calendar/scheduling-button-script.css" rel="stylesheet">
<script src="https://calendar.google.com/calendar/scheduling-button-script.js" async></script>

<script define:vars={{ appointmentUrl, buttonColor, buttonText }}>
// Optional: Try to load Google Calendar integration as enhancement
document.addEventListener('DOMContentLoaded', function() {
	// Only try Google Calendar if script is available and URL is configured
	if (typeof calendar !== 'undefined' && calendar.schedulingButton && appointmentUrl !== 'YOUR_GOOGLE_CALENDAR_APPOINTMENT_URL') {
		try {
			calendar.schedulingButton.load({
				url: appointmentUrl,
				color: buttonColor,
				label: buttonText,
				target: document.getElementById('google-appointment-button')
			});
		} catch (error) {
			console.log('Google Calendar integration not available, using direct link');
		}
	}
});
</script>

<style>
/* Style the primary demo button */
.primary-demo-button {
	background: linear-gradient(135deg, #9b00ff 0%, #7c3aed 100%);
	box-shadow: 0 4px 15px rgba(155, 0, 255, 0.3);
}

.primary-demo-button:hover {
	box-shadow: 0 8px 25px rgba(155, 0, 255, 0.4);
	transform: translateY(-2px);
}

/* Google Calendar button container */
#google-appointment-button {
	min-height: 0;
}
</style>
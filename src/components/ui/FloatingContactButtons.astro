---
// Floating Contact Buttons
// ------------
// Description: Container for WhatsApp and Phone floating buttons
// Properties:
// - phoneNumber: The phone number for both WhatsApp and calls
// - whatsappMessage: Default WhatsApp message
// - position: Position of the buttons
// - classes: Additional classes
// ------------

// Props
type Props = {
	phoneNumber: string
	whatsappMessage?: string
	position?: 'bottom-right' | 'bottom-left' | 'top-right' | 'top-left'
	classes?: string
}

const { 
	phoneNumber,
	whatsappMessage = "¡Hola! Me interesa conocer más sobre Katuq 😊",
	position = 'bottom-right',
	classes 
} = Astro.props

// Generate URLs
const encodedMessage = encodeURIComponent(whatsappMessage)
const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodedMessage}`
const phoneUrl = `tel:${phoneNumber}`

// Position classes
const positionClasses = {
	'bottom-right': 'bottom-6 right-6',
	'bottom-left': 'bottom-6 left-6', 
	'top-right': 'top-6 right-6',
	'top-left': 'top-6 left-6'
}
---

<div 
	id="floating-contact-buttons" 
	class:list={[
		'fixed z-50 flex flex-col gap-3',
		positionClasses[position],
		{ [`${classes}`]: classes }
	]}
>
	<!-- WhatsApp Button -->
	<div class="group relative">
		<a 
			href={whatsappUrl}
			target="_blank"
			rel="noopener noreferrer"
			class="flex items-center justify-center w-14 h-14 bg-green-500 hover:bg-green-600 text-white rounded-full shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-110 animate-pulse hover:animate-none"
			aria-label="Contáctanos por WhatsApp"
			id="whatsapp-link"
		>
			<!-- WhatsApp SVG Icon -->
			<svg class="w-8 h-8" viewBox="0 0 24 24" fill="currentColor">
				<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.465 3.488"/>
			</svg>
		</a>
		
		<!-- WhatsApp Tooltip -->
		<div class="absolute bottom-16 right-0 mb-2 hidden group-hover:block animate-fade-in">
			<div class="bg-neutral-800 text-white text-sm rounded-lg py-2 px-3 whitespace-nowrap shadow-lg">
				<span>¡Chatea con nosotros!</span>
				<div class="absolute top-full right-4 w-0 h-0 border-l-4 border-r-4 border-t-4 border-transparent border-t-neutral-800"></div>
			</div>
		</div>
	</div>

	<!-- Phone Button -->
	<div class="group relative">
		<a 
			href={phoneUrl}
			class="flex items-center justify-center w-12 h-12 bg-blue-500 hover:bg-blue-600 text-white rounded-full shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-110 breathing-animation"
			aria-label="Llamar a Katuq"
			id="phone-link"
		>
			<!-- Phone SVG Icon -->
			<svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
				<path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
			</svg>
		</a>
		
		<!-- Phone Tooltip -->
		<div class="absolute bottom-14 right-0 mb-2 hidden group-hover:block animate-fade-in">
			<div class="bg-neutral-800 text-white text-sm rounded-lg py-2 px-3 whitespace-nowrap shadow-lg">
				<span>¡Llámanos directamente!</span>
				<div class="absolute top-full right-4 w-0 h-0 border-l-4 border-r-4 border-t-4 border-transparent border-t-neutral-800"></div>
			</div>
		</div>
	</div>
</div>

<style>
	/* Animations */
	@keyframes fade-in {
		0% {
			opacity: 0;
			transform: translateY(10px);
		}
		100% {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.animate-fade-in {
		animation: fade-in 0.3s ease-out;
	}

	/* Breathing animation for phone button */
	@keyframes breathing {
		0%, 100% {
			transform: scale(1);
		}
		50% {
			transform: scale(1.05);
		}
	}

	.breathing-animation {
		animation: breathing 3s ease-in-out infinite;
		animation-delay: 1.5s; /* Delay to alternate with WhatsApp button */
	}

	.breathing-animation:hover {
		animation: none;
	}

	/* Additional responsive adjustments */
	@media (max-width: 768px) {
		#floating-contact-buttons {
			bottom: 1rem;
			right: 1rem;
			gap: 0.75rem;
		}
		
		#floating-contact-buttons a {
			width: 3.5rem;
			height: 3.5rem;
		}

		#floating-contact-buttons [id="phone-link"] {
			width: 3rem;
			height: 3rem;
		}
		
		#floating-contact-buttons .tooltip {
			display: none;
		}
	}

	/* Dark mode adjustments */
	.dark #floating-contact-buttons .bg-neutral-800 {
		background-color: rgb(38 38 38);
	}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
	const whatsappLink = document.getElementById('whatsapp-link');
	const phoneLink = document.getElementById('phone-link');
	
	// Track WhatsApp clicks
	if (whatsappLink) {
		whatsappLink.addEventListener('click', function() {
			console.log('WhatsApp button clicked');
			
			if (typeof gtag !== 'undefined') {
				gtag('event', 'click', {
					event_category: 'engagement',
					event_label: 'whatsapp_button',
					value: 1
				});
			}
		});
	}

	// Track Phone clicks
	if (phoneLink) {
		phoneLink.addEventListener('click', function() {
			console.log('Phone button clicked');
			
			if (typeof gtag !== 'undefined') {
				gtag('event', 'click', {
					event_category: 'engagement', 
					event_label: 'phone_button',
					value: 1
				});
			}
		});
	}
});
</script>
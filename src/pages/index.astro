---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'

// - UI
import Hero from '../components/blocks/hero/HomeCTA.astro'
import Features from '../components/blocks/features/FeatureCards.astro'
import Testimonial from '../components/blocks/testimonials/BasicDark.astro'
import HighlightBlocks from '../components/blocks/highlights/HightlightRows.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'
import SectionKatuq from '../components/ui/SectionKatuq.astro'
import ContactHero from '../components/blocks/hero/ContactHero.astro'
import CustomerLogos from '../components/blocks/socialproof/CustomerLogos.astro'
import ROICalculator from '../components/blocks/lead-magnets/ROICalculator.astro'
import ExitIntentPopup from '../components/blocks/lead-magnets/ExitIntentPopup.astro'

// Content
// - Testimonial background
import Katuq from '../assets/Katuq.jpg'
// - SEO
const SEO = {
	title: 'Katuq | El éxito esta en los detalles',
	description:
		'Katuq is a powerful productivity toolkit designed to enhance your workflow and boost your productivity. With features like analytics, security, and integrations, Katuq is the perfect solution for your business.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero />
	<CustomerLogos />
	<Features id="features" />
	<ROICalculator />
	<SectionKatuq bg={Katuq.src} />
	<HighlightBlocks />
	<ExitIntentPopup />
</Layout>
